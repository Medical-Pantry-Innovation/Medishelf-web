# Copy this file to .env.local before starting the app:
#
#   cp .env.example .env.local
#
# The values below are placeholders. They are enough to boot the app and open
# the extraction walkthrough at /items/demo, which calls neither Supabase nor a
# model. Login, the review queue and a live extraction all need real values.

# --- Supabase -------------------------------------------------------------
# Required for the app to start at all: lib/supabaseClient.js builds its client
# at module load, and @supabase/supabase-js throws when the URL is missing.
NEXT_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key

# Server-side only. Used by the API routes to read images and write results.
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key

# --- Extraction (lib/ocr) -------------------------------------------------
# Must be a pinned provider/model slug. Floating aliases are rejected at
# startup, because a result stored today has to stay interpretable later:
# "openrouter/auto", anything beginning "~", and any "latest" alias all fail.
OPENROUTER_MODEL=google/gemini-2.5-flash

# Leave unset to run without extraction. The walkthrough at /items/demo does
# not need it; the Re-run button and the upload flow do.
# OPENROUTER_API_KEY=

# Optional. Defaults to https://openrouter.ai/api/v1 and 60000 ms.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_TIMEOUT_MS=60000
